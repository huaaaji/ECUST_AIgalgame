{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galgame.local/schemas/v2/op.schema.json",
  "title": "Op 原语（Proposal）",
  "description": "Arbiter 唯一接受的 13 个状态变更原语（闭集），模块/导演/记忆层只能产出这些 Proposal，由 Arbiter.apply 校验后落库并写事件日志（03 §2.3 Proposal、03 §3）。本文件是 packages/shared/src/contract/types.ts 与 packages/shared/src/zod/op.ts 的 JSON Schema 镜像，字段名、可选性、枚举值以它们为准；新增原语必须 bump apiVersion。",
  "$comment": "参数真源是 packages/shared/src/contract/types.ts 的 XxxArgs 与 packages/shared/src/zod/op.ts 的 XxxArgsSchema；本文件只做形状与枚举镜像，可解析性由 `npm run check:contract` 校验。数值钳制、邻接判定、canon 锁定等语义裁决属于 Arbiter，不在这里表达。",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "description": "实体/边/剧情的 id，形如 <kind>_<slug>，slug 只含 [a-z0-9_]，长度 2~32（03 §0.3）；slug 细节由 Arbiter 校验，这里只做长度兜底。"
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "description": "玩家或 NPC 的实体 id，前缀是 plr_ 或 npc_（03 §0.3）。"
    },
    "attrValue": {
      "description": "属性值只允许 number/string/boolean 三种（03 §2.1 AttrValue）；number 必须是有限数。",
      "oneOf": [
        {
          "type": "number",
          "description": "数值型属性（体力、钱、好感度等）。"
        },
        {
          "type": "string",
          "description": "字符串/枚举型属性（从 registry 的 values 里取）。"
        },
        {
          "type": "boolean",
          "description": "开关型属性（是否迟到、是否见过某人等）。"
        }
      ]
    },
    "entityKind": {
      "type": "string",
      "enum": [
        "plr",
        "npc",
        "loc",
        "item",
        "fact",
        "lore",
        "plot"
      ],
      "description": "实体七类：玩家/ NPC /地点/物品/事实/世界观/剧情线（03 §0.3、§2.1）。"
    },
    "origin": {
      "type": "string",
      "enum": [
        "seed",
        "ai",
        "system"
      ],
      "description": "来源：seed=人工预置，ai=AI 生成（必须 canon:false），system=引擎生成。"
    },
    "entityStatus": {
      "type": "string",
      "enum": [
        "active",
        "dormant",
        "tombstoned"
      ],
      "description": "实体状态：active 正常、dormant 休眠、tombstoned 软删除（记录保留，id 永不复用）。"
    },
    "linkKind": {
      "type": "string",
      "enum": [
        "knows",
        "owes",
        "holds",
        "present",
        "located_in",
        "member_of"
      ],
      "description": "关系边类型（以 types.ts LinkKind 为准）：knows 认识、owes 欠人情、holds 持有、present 在场、located_in 位于、member_of 属于。"
    },
    "phase": {
      "type": "string",
      "enum": [
        "morning",
        "noon",
        "afternoon",
        "evening",
        "night"
      ],
      "description": "游戏内时段，5 个值（以 types.ts Phase 为准，注意没有 forenoon）；入夜 north 触发 tick.night。"
    },
    "reason": {
      "type": "string",
      "maxLength": 60,
      "description": "一句话说明为什么提议，≤60 字，只进日志不给玩家看（03 §2.3）。"
    },
    "by": {
      "type": "string",
      "maxLength": 64,
      "description": "提议来源：mod.<moduleId> / npc.director / engine.turn。"
    },
    "proposalBase": {
      "type": "object",
      "description": "所有 Proposal 的共同外壳：op + args，可选 reason/by。",
      "required": [
        "op",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "attr.delta — 数值增减",
      "description": "03 §3 op 1：按增量改数值属性，产出 attr.changed；越界由 Arbiter 按 registry 的 min/max 钳制，同回合同实体同 key 累计超 maxDeltaPerTurn 时 clamp 并记 clamped。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "attr.delta"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entityId",
            "key",
            "delta"
          ],
          "properties": {
            "entityId": {
              "$ref": "#/$defs/id",
              "description": "被改的实体 id。"
            },
            "key": {
              "$ref": "#/$defs/id",
              "description": "属性键：必须在 registry 声明，或以 x. 开头（x 区不校验类型，见 03 §0.5）。"
            },
            "delta": {
              "type": "number",
              "description": "增量，可负。真实可写范围由 registry 的 min/max 与 maxDeltaPerTurn 决定，超出由 Arbiter clamp（03 §3），所以这里不设 minimum/maximum。"
            },
            "mustKeep": {
              "type": "boolean",
              "description": "强约束：被钳制即整条拒绝（E_PRECONDITION），用于支付类操作"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "attr.delta",
          "args": {
            "entityId": "plr_me",
            "key": "money",
            "delta": -3
          },
          "reason": "在小卖部买了菠萝包",
          "by": "mod.trade"
        },
        {
          "op": "attr.delta",
          "args": {
            "entityId": "npc_zhangsan",
            "key": "guard",
            "delta": 5
          },
          "reason": "被追问上周五的行踪，戒备上升",
          "by": "npc.director"
        }
      ]
    },
    {
      "title": "attr.set — 直接赋值",
      "description": "03 §3 op 2：直接设值，产出 attr.changed；用于字符串/布尔/枚举属性，canon 实体白名单外的属性会被拒（E_CANON_LOCKED）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "attr.set"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entityId",
            "key",
            "value"
          ],
          "properties": {
            "entityId": {
              "$ref": "#/$defs/id",
              "description": "被改的实体 id。"
            },
            "key": {
              "$ref": "#/$defs/id",
              "description": "属性键：registry 已声明，或以 x. 开头。"
            },
            "value": {
              "$ref": "#/$defs/attrValue",
              "description": "新值，整体覆盖旧值。"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "attr.set",
          "args": {
            "entityId": "npc_zhangsan",
            "key": "mood",
            "value": "tense"
          },
          "reason": "刚和王五在楼梯间低声说完话",
          "by": "npc.director"
        }
      ]
    },
    {
      "title": "entity.create — 新建实体",
      "description": "03 §3 op 3：新建实体，产出 entity.created。id 已存在会被拒（E_ID_TAKEN）；AI 生成的内容必须 origin=ai、canon=false。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "entity.create"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "name"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id",
              "description": "新实体 id，永不复用。"
            },
            "kind": {
              "$ref": "#/$defs/entityKind",
              "description": "实体类别。"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "中文显示名，只用于展示与生成，不参与 id。"
            },
            "attrs": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/attrValue"
              },
              "description": "初始属性表，键受 registry / x 区约束，值只允许三种标量。"
            },
            "tags": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 32
              },
              "description": "检索标签，如 迟到、社团、秘密。"
            },
            "origin": {
              "$ref": "#/$defs/origin",
              "description": "来源，AI 生成的实体必须填 ai。"
            },
            "canon": {
              "type": "boolean",
              "description": "是否人工锁定；AI 产出只能 false。"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "entity.create",
          "args": {
            "id": "item_bread",
            "kind": "item",
            "name": "菠萝包",
            "attrs": {
              "price": 3,
              "tasty": true
            },
            "tags": [
              "小卖部",
              "零食"
            ],
            "origin": "ai",
            "canon": false
          },
          "reason": "玩家第一次进货时临时生成",
          "by": "mod.trade"
        }
      ]
    },
    {
      "title": "entity.update — 改名/改标签/改状态",
      "description": "03 §3 op 4：改 name/tags/status，产出 entity.updated；属性变更走 attr.* 而不是这里。canon 与 plr 实体的身份字段只读（改则 E_CANON_LOCKED）。至少给一个字段才有意义（与 zod 一致，本文件不强制）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "entity.update"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entityId"
          ],
          "properties": {
            "entityId": {
              "$ref": "#/$defs/id",
              "description": "目标实体 id。"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "改名；canon 实体通常被锁，会被拒。"
            },
            "tags": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 32
              },
              "description": "整体替换标签。"
            },
            "status": {
              "$ref": "#/$defs/entityStatus",
              "description": "状态迁移，如 dormant 让 NPC 暂时不参与。"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "entity.update",
          "args": {
            "entityId": "npc_zhangsan",
            "tags": [
              "同班",
              "可疑"
            ],
            "status": "active"
          },
          "reason": "撞见他在宿舍楼下等人，打上可疑标签",
          "by": "npc.director"
        }
      ]
    },
    {
      "title": "entity.tombstone — 软删除",
      "description": "03 §3 op 5：软删除实体，产出 entity.tombstoned；记录保留、id 永不复用，只能由 Arbiter 落库。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "entity.tombstone"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entityId"
          ],
          "properties": {
            "entityId": {
              "$ref": "#/$defs/id",
              "description": "要软删除的实体 id。"
            },
            "reason": {
              "type": "string",
              "maxLength": 60,
              "description": "删除原因，进事件日志。"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "entity.tombstone",
          "args": {
            "entityId": "item_bread",
            "reason": "被吃掉了"
          },
          "reason": "玩家吃掉了菠萝包",
          "by": "mod.trade"
        }
      ]
    },
    {
      "title": "link.create — 建关系边",
      "description": "03 §3 op 6：建关系边，产出 link.created；重复建同一条边按 kind+from+to 去重。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "link.create"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "from",
            "to"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/linkKind",
              "description": "关系类型，六选一。"
            },
            "from": {
              "$ref": "#/$defs/id",
              "description": "起点实体 id。"
            },
            "to": {
              "$ref": "#/$defs/id",
              "description": "终点实体 id。"
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "关系强度 0~100，越强表示越亲近或负担越重。"
            },
            "audience": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/actorId"
              },
              "description": "可见范围；不填表示公开。"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "link.create",
          "args": {
            "kind": "holds",
            "from": "plr_me",
            "to": "item_bread",
            "weight": 10
          },
          "reason": "玩家买下了菠萝包",
          "by": "mod.trade"
        },
        {
          "op": "link.create",
          "args": {
            "kind": "knows",
            "from": "npc_zhangsan",
            "to": "npc_wangwu",
            "weight": 60,
            "audience": [
              "npc_zhangsan",
              "npc_wangwu"
            ]
          },
          "reason": "两人在楼梯间密谈后建立暗线联系",
          "by": "npc.director"
        }
      ]
    },
    {
      "title": "link.remove — 删关系边",
      "description": "03 §3 op 7：删关系边，产出 link.removed；linkId 或 kind/from/to 至少要给一个，否则匹配到空集（这是 zod 的 refine，本文件用 anyOf 表达）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "link.remove"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkId": {
              "$ref": "#/$defs/id",
              "description": "按边 id 精确删除。"
            },
            "kind": {
              "$ref": "#/$defs/linkKind",
              "description": "按类型匹配。"
            },
            "from": {
              "$ref": "#/$defs/id",
              "description": "按起点匹配。"
            },
            "to": {
              "$ref": "#/$defs/id",
              "description": "按终点匹配。"
            }
          },
          "anyOf": [
            {
              "required": [
                "linkId"
              ]
            },
            {
              "required": [
                "kind"
              ]
            },
            {
              "required": [
                "from"
              ]
            },
            {
              "required": [
                "to"
              ]
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "link.remove",
          "args": {
            "kind": "holds",
            "from": "plr_me",
            "to": "item_bread"
          },
          "reason": "菠萝包吃完了，持有关系结束",
          "by": "mod.trade"
        }
      ]
    },
    {
      "title": "move.to — 移动",
      "description": "03 §3 op 8：移动 actor 并把目标地点加进 scene.presentIds，产出 actor.moved；不邻接则拒绝（E_NOT_ADJACENT），邻接判断由 Arbiter 做。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "move.to"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actorId",
            "locId"
          ],
          "properties": {
            "actorId": {
              "$ref": "#/$defs/actorId",
              "description": "要移动的玩家或 NPC。"
            },
            "locId": {
              "$ref": "#/$defs/id",
              "description": "目标地点实体 id，前缀 loc_。"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "move.to",
          "args": {
            "actorId": "plr_me",
            "locId": "loc_corridor_2f"
          },
          "reason": "午休时间去二楼走廊找张叁",
          "by": "engine.turn"
        }
      ]
    },
    {
      "title": "time.advance — 推进时间",
      "description": "03 §3 op 9：推进游戏内时间，产出 clock.advanced；ticks 不填按 1 处理，入夜触发 tick.night。只有引擎身份可提，模块提 → E_ILLEGAL_OP。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "time.advance"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ticks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "推进几行（回合），不填=1，上限 8。"
            },
            "phase": {
              "$ref": "#/$defs/phase",
              "description": "直接跳到指定时段。"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "time.advance",
          "args": {
            "ticks": 2,
            "phase": "evening"
          },
          "reason": "玩家在图书馆自习到晚上",
          "by": "engine.turn"
        }
      ]
    },
    {
      "title": "scene.set — 改场景",
      "description": "03 §3 op 10：改地点/在场者/道具，产出 scene.changed；presentIds 是唯一真源，present 边由引擎据此重建。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "scene.set"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "locId": {
              "$ref": "#/$defs/id",
              "description": "切换地点，前缀 loc_。"
            },
            "presentIds": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/actorId"
              },
              "description": "整体替换在场者（唯一真源）。"
            },
            "props": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/id"
              },
              "description": "整体替换场景道具。"
            }
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "by": {
          "$ref": "#/$defs/by"
        }
      },
      "examples": [
        {
          "op": "scene.set",
          "args": {
            "locId": "loc_classroom_2_3",
            "presentIds": [
              "plr_me",
              "npc_zhangsan",
              "npc_wangwu"
            ]
          },
          "reason": "下午第一节课，三人在教室",
          "by": "engine.turn"
        }
      ]
    },
    {
